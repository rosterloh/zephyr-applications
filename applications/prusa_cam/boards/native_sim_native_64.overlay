 *
 * A canned-JPEG camera (sim/sim_cam.c) and a GPIO flash LED, so the whole app
 * runs on the host.
 */

/ {
	chosen {
		zephyr,camera = &sim_cam;
	};

	sim_cam: sim-cam {
		compatible = "vnd,jpeg-camera";
	};
};

&leds {
	flash_led: flash_led {
		gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
	};
};
