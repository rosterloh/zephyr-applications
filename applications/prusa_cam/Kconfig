mainmenu "prusa_cam"

menu "prusa_cam"

config PRUSA_CAM_CONNECT_HOST
	string "Prusa Connect host"
	default "camera-service.prusa3d.com"
	help
	  Prusa camera service, API v1: https://camera-service.prusa3d.com/docs/

config PRUSA_CAM_CONNECT_STACK_SIZE
	int "Uploader thread stack size"
	default 6144
	help
	  The TLS handshake runs on this stack.

endmenu

source "Kconfig.zephyr"
