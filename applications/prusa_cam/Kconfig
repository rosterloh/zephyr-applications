mainmenu "prusa_cam"

menu "prusa_cam"

config PRUSA_CAM_CONNECT_STACK_SIZE
	int "Uploader thread stack size"
	default 6144
	help
	  The TLS handshake runs on this stack.

config PRUSA_CAM_STREAM_STACK_SIZE
	int "MJPEG stream thread stack size"
	default 2048

config PRUSA_CAM_MANUFACTURER
	string "Camera manufacturer reported to Prusa Connect"
	default "DFRobot" if BOARD_DFROBOT_ESP32S3_AI_CAM
	default "AI-Thinker"

config PRUSA_CAM_MODEL
	string "Camera model reported to Prusa Connect"
	default "DFR1154" if BOARD_DFROBOT_ESP32S3_AI_CAM
	default "ESP32-CAM"

endmenu

rsource "../common/prusa_camera/Kconfig"
rsource "../common/build_id/Kconfig"
rsource "../common/watchdog/Kconfig"
rsource "../common/img_confirm/Kconfig"

source "Kconfig.zephyr"
