mainmenu "prusa_cam"

menu "prusa_cam"

config PRUSA_CAM_CONNECT_STACK_SIZE
	int "Uploader thread stack size"
	default 6144
	help
	  The TLS handshake runs on this stack.

config PRUSA_CAM_STREAM_STACK_SIZE
	int "MJPEG stream thread stack size"
	default 2048

config PRUSA_CAM_MANUFACTURER
	string "Camera manufacturer reported to Prusa Connect"
	default "DFRobot" if BOARD_DFROBOT_ESP32S3_AI_CAM
	default "AI-Thinker"

config PRUSA_CAM_MODEL
	string "Camera model reported to Prusa Connect"
	default "DFR1154" if BOARD_DFROBOT_ESP32S3_AI_CAM
	default "ESP32-CAM"

# native_sim binds host ports: below 1024 needs root, and protective_stop
# has 8080 when twister runs both at once.
config PRUSA_CAM_HTTP_PORT
	int "Config page and API port"
	default 8280 if BOARD_NATIVE_SIM
	default 80

config PRUSA_CAM_STREAM_PORT
	int "MJPEG stream port"
	default 8281 if BOARD_NATIVE_SIM
	default 81
	help
	  The config page links to port 81.

config PRUSA_CAM_ESPHOME
	bool "Home Assistant (ESPHome native API)"
	default y
	select ESPHOME_API
	select ESPHOME_API_NOISE
	help
	  Show the camera in Home Assistant as an ESPHome device: upload
	  status, uploads, WiFi signal, the flash LED setting and an upload
	  button. Noise encrypted; set the key with `prusa ha_key` or the
	  config page. Until a key is set every client is refused.

config ZVFS_OPEN_ADD_SIZE_PRUSA_CAM_ESPHOME
	int
	default 2 if PRUSA_CAM_ESPHOME
	default 0
	help
	  The API's listening socket and its one client.

endmenu

rsource "../common/prusa_camera/Kconfig"
rsource "../common/build_id/Kconfig"
rsource "../common/watchdog/Kconfig"
rsource "../common/img_confirm/Kconfig"

source "Kconfig.zephyr"
