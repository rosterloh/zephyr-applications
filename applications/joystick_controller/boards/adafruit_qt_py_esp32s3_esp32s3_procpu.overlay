#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * Adafruit Joy FeatherWing (seesaw SAMD09 @ 0x49) on the STEMMA QT bus.
 * 2-axis stick only, so this build publishes linear.x / linear.y only.
 *
 * Verify on hardware: the X/Y channel order, the invert flags and button A's
 * pin. From Adafruit's Joy FeatherWing guide: stick on seesaw pins 2/3
 * (logical ADC 0/1), buttons A=6, B=7, Y=9, X=10, Select=14. The INT pin is
 * not wired to the QT Py, so the deadman is polled.
 */

&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;

	joy_wing: seesaw@49 {
		compatible = "adafruit,seesaw-mfd";
		reg = <0x49>;

		joy_adc: adc {
			compatible = "adafruit,seesaw-adc";
			#io-channel-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			channel@0 {
				reg = <0>;
				zephyr,gain = "ADC_GAIN_1";
				zephyr,reference = "ADC_REF_INTERNAL";
				zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
				zephyr,resolution = <10>;
			};

			channel@1 {
				reg = <1>;
				zephyr,gain = "ADC_GAIN_1";
				zephyr,reference = "ADC_REF_INTERNAL";
				zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
				zephyr,resolution = <10>;
			};
		};

		joy_gpio: gpio {
			compatible = "adafruit,seesaw-gpio";
			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

/ {
	joystick: analog-axis {
		compatible = "analog-axis";
		poll-period-ms = <15>;

		axis-x {
			io-channels = <&joy_adc 0>;
			in-min = <0>;
			in-max = <1023>;
			in-deadzone = <40>;
			out-min = <(-1000)>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_X>;
		};

		axis-y {
			io-channels = <&joy_adc 1>;
			in-min = <0>;
			in-max = <1023>;
			in-deadzone = <40>;
			out-min = <(-1000)>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_Y>;
		};
	};

	deadman: gpio-keys {
		compatible = "gpio-keys";
		polling-mode;

		button_a {
			gpios = <&joy_gpio 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_BTN_0>;
		};
	};
};
