#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/*
 * HZQS R400B-M4 4-axis joystick (10 kOhm pots, 50 degrees: the full stick
 * travel, so close to the full ADC range) in mechanical-parts/joystick-p4-box,
 * with its enable rocker and mod button, on the Raspberry Pi layout header:
 *
 *   input   GPIO  header pin   wiring
 *   X       20    13           X pot wiper (ADC1 ch4)
 *   Y       21    11           Y pot wiper (ADC1 ch5)
 *   Z       22    12           handle pot black, its wiper (ADC1 ch6)
 *   pots    -     1 / 6        3V3 / GND: handle pot red / white, X and Y pot
 *                              outer lugs daisy-chained to them
 *   grasp   23    7            handle button, blue/blue, other side to GND
 *   enable  6     15           Arcolectric H8600 rocker (latching), to GPIO5
 *   (gnd)   5     16           driven low by a hog: the rocker's 2x1 plug
 *                              has no GND beside pin 15
 *   mod     48    33           RAFI 1.10.001.001 button (normally closed), to GND pin 34
 *
 * Not the BOOT button: GPIO35 is shared with RMII TXD1 while Ethernet is up.
 * in-min/in-max are full scale until `teleop cal` stores the real range. Which
 * outer pot lug gets 3V3 sets the axis sign; fix a wrong one with
 * invert-output.
 */

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&gpio0 {
	enable-gnd-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "enable-gnd";
	};
};

/ {
	/* One analog-axis per channel: without CONFIG_ADC_ESP32_DMA the ESP32 ADC
	 * driver rejects multi-channel sequences with -ENOTSUP.
	 */
	stick_x: stick-x {
		compatible = "analog-axis";
		poll-period-ms = <15>;

		axis {
			io-channels = <&adc0 4>;
			in-min = <0>;
			in-max = <4095>;
			in-deadzone = <80>;
			out-min = <(-1000)>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_X>;
		};
	};

	stick_y: stick-y {
		compatible = "analog-axis";
		poll-period-ms = <15>;

		axis {
			io-channels = <&adc0 5>;
			in-min = <0>;
			in-max = <4095>;
			in-deadzone = <80>;
			out-min = <(-1000)>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_Y>;
		};
	};

	stick_rz: stick-rz {
		compatible = "analog-axis";
		poll-period-ms = <15>;

		axis {
			io-channels = <&adc0 6>;
			/* Clockwise raises the wiper; ROS wants anticlockwise positive.
			 * Needs zephyr/patches 0004 for a signed out range.
			 */
			invert-output;
			in-min = <0>;
			in-max = <4095>;
			in-deadzone = <80>;
			out-min = <(-1000)>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_RZ>;
		};
	};

	/* Read directly by main every tick, so a failed read counts as off. */
	zephyr,user {
		enable-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* Normally closed: shorted to GND at rest, so pressed reads high. */
		mod-gpios = <&gpio1 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; /* GPIO48 */
		grasp-gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
