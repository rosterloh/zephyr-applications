# The app ships with no password (admin disabled). This suite sets one so the
# admin cases have something to authenticate against; the admin_disabled
# variant in testcase.yaml empties it again.
config PROTECTIVE_STOP_ADMIN_PASSWORD
	string "Admin password"
	default "s3cret"

source "Kconfig.zephyr"
