/*
 * Copyright (c) 2026 Richard Osterloh <richard.osterloh@gmail.com>
 * SPDX-License-Identifier: Apache-2.0
 *
 * Dual-channel stop-switch loopback, as wired in the pstop enclosure.
 *
 * Each channel runs out of a drive pin, through one pole of the external DPST
 * normally-closed switch, and back into a sense pin pulled DOWN -- so an open
 * loop, a cut wire or a pulled plug all read 0 = STOP. The two channels are
 * independent so that a single-pole fault makes the two lockstep samplers
 * disagree, which silences transmission and stops every bonded machine.
 *
 *     channel A:  GPIO39 (drive) --> DPST pole 1 --> GPIO40 (sense)
 *     channel B:  GPIO41 (drive) --> DPST pole 2 --> GPIO42 (sense)
 *
 * These are enclosure wiring, not board hardware, which is why they live in
 * an app overlay rather than in the board definition. Pin numbering matches
 * upstream's ESP-IDF firmware (firmware/main/main.c) so the same harness fits
 * either build.
 *
 * GPIO39-42 sit on gpio1, which covers pins 32-48 on the ESP32-S3, hence the
 * offsets 7-10 below.
 *
 * The 16-LED WS2812 status ring is enclosure wiring too: its data line is
 * GPIO17, driven from RMT transmit channel 1 (channel 0 drives the onboard
 * status pixel on GPIO21, which being soldered to the board lives in the
 * board definition as led-strip). leds.c finds the ring as pstop-ring.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

/ {
	zephyr,user {
		estop-a-out-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;  /* GPIO39 */
		estop-a-in-gpios  = <&gpio1 8 GPIO_ACTIVE_HIGH>;  /* GPIO40 */
		estop-b-out-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;  /* GPIO41 */
		estop-b-in-gpios  = <&gpio1 10 GPIO_ACTIVE_HIGH>; /* GPIO42 */
	};

	aliases {
		pstop-ring = &pstop_ring;
	};

	pstop_ring: pstop_ring {
		compatible = "worldsemi,ws2812-pulse-io";
		pulse-ios = <&rmt 1>;
		chain-length = <16>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};

/* Both RMT transmit pins in one state: the controller applies one pinctrl
 * state for all its channels.
 */
&rmt_ws2812 {
	group1 {
		pinmux = <RMT_OUT0_GPIO21>, <RMT_OUT1_GPIO17>;
	};
};

/* Coredump pseudo-device: applications/common/build_id registers the build-ID
 * note with it at boot, so every dump names its ELF. */
/ {
	app_coredump: app-coredump {
		compatible = "zephyr,coredump";
		coredump-type = "COREDUMP_TYPE_MEMCPY";
	};
};
