/*
 * Adafruit NeoKey 1x4 QT I2C Keypad (PID 4980) on the STEMMA QT bus.
 *
 * The keypad is an Adafruit seesaw device: the 4 mechanical keys are wired to
 * seesaw GPIO pins 4,5,6,7 (active-low, internal pull-up) and the 4 NeoPixels
 * are chained on seesaw pin 3. Drivers come from the rosterloh-drivers module.
 */

#include <zephyr/dt-bindings/led/led.h>

&zephyr_i2c {
	status = "okay";

	neokey_mfd: seesaw@30 {
		status = "okay";
		compatible = "adafruit,seesaw-mfd";
		reg = <0x30>;
		read-delay-us = <10000>;

		neokey_gpio: gpio {
			status = "okay";
			compatible = "adafruit,seesaw-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
		};

		neokey_leds: neopixel {
			status = "okay";
			compatible = "adafruit,seesaw-neopixel";
			chain-length = <4>;
			color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
			seesaw-pin = <3>;
			frequency = <800000>;
		};
	};
};
