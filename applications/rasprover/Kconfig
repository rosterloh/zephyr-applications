mainmenu "Application options"

# Workaround for an upstream regression: mcumgr's img_mgmt.c references
# CONFIG_FLASH_BASE_ADDRESS, but arch/Kconfig only defines that symbol for
# ARC/ARM/ARM64/X86/RISCV/RX/OPENRISC/ARCH_POSIX — not Xtensa. ESP32 flash
# partition addresses are zero-based offsets, so 0 is the correct base.
# Remove once deps/zephyr carries the upstream fix.
config FLASH_BASE_ADDRESS
	hex
	depends on XTENSA
	default 0

if DNS_RESOLVER

config DNS_SERVER_IP_ADDRESSES
	default y

config DNS_SERVER1
	default "1.1.1.1"

endif # DNS_RESOLVER

menuconfig APP_DISPLAY
	bool "Enable App Display"
	select DISPLAY
	select LVGL
	# select LV_CONF_MINIMAL

if APP_DISPLAY

config APP_DISPLAY_BLANK_ON_IDLE
	bool "Blank display on idle"
#	default y if SSD1306

choice APP_DISPLAY_WORK_QUEUE
	prompt "Work queue selection for UI updates"

config APP_DISPLAY_WORK_QUEUE_SYSTEM
	bool "Use default system work queue for UI updates"

config APP_DISPLAY_WORK_QUEUE_DEDICATED
	bool "Use dedicated work queue for UI updates"

endchoice

if APP_DISPLAY_WORK_QUEUE_DEDICATED

config APP_DISPLAY_DEDICATED_THREAD_STACK_SIZE
	int "Stack size for dedicated UI thread/queue"
	default 2048

config APP_DISPLAY_DEDICATED_THREAD_PRIORITY
	int "Thread priority for dedicated UI thread/queue"
	default 5

endif # APP_DISPLAY_WORK_QUEUE_DEDICATED

endif # APP_DISPLAY

menuconfig APP_PICOROS
	bool "Enable the Pico-ROS node"
	select PICOROS
	default y
	help
	  Publishes BatteryState and JointState and subscribes to Twist and
	  JointState commands as an rmw_zenoh-compatible ROS 2 node. Replaces
	  the previous raw zenoh-pico publisher, which produced bare CDR under
	  rt/<topic> for a host-side zenoh-bridge-ros2dds.

if APP_PICOROS

config APP_PICOROS_LOCATOR
	string "Zenoh locator for the host router"
	default "tcp/192.168.1.10:7447"
	help
	  Locator string passed to picoros_interface_init() as the connect
	  endpoint. Format is '<protocol>/<host>:<port>'. The host runs
	  rmw_zenohd (the router that ships with rmw_zenoh), whose default
	  listen endpoint is tcp/0.0.0.0:7447.

config APP_PICOROS_NODE_NAME
	string "ROS 2 node name"
	default "rasprover"
	help
	  Name this node announces in its @ros2_lv liveliness token, and the
	  name `ros2 node list` shows. Service key expressions are prefixed
	  with it; topic key expressions are not.

config APP_PICOROS_DOMAIN_ID
	int "ROS domain ID"
	default 0
	range 0 232
	help
	  Must match ROS_DOMAIN_ID on the host. It is the first segment of
	  every key expression, so a mismatch shows up as a node that connects
	  to the router but is invisible to ROS.

config APP_PICOROS_BATTERY_STATE_TOPIC
	string "ROS topic for sensor_msgs/BatteryState"
	default "rasprover/battery_state"
	help
	  Fully qualified ROS topic name without the leading slash. Pico-ROS
	  builds the rmw_zenoh key expression
	  <domain>/<topic>/<type>_/RIHS01_<hash> from it, so unlike the old
	  zenoh keys this must not carry an 'rt/' prefix.

config APP_PICOROS_CMD_VEL_TOPIC
	string "ROS topic for geometry_msgs/Twist velocity commands"
	default "rasprover/cmd_vel"
	depends on APP_MOTORS

config APP_PICOROS_JOINT_STATE_TOPIC
	string "ROS topic for sensor_msgs/JointState feedback"
	default "joint_states"
	depends on APP_MOTORS
	help
	  Unprefixed by default so it lands on the conventional ROS 2
	  /joint_states that robot_state_publisher listens on.

config APP_PICOROS_JOINT_STATE_PUBLISH_HZ
	int "JointState publish rate in Hz"
	default 20
	range 1 100
	depends on APP_MOTORS

endif # APP_PICOROS

menuconfig APP_TIME_SYNC
	bool "Enable SNTP time synchronization"
	default y if APP_PICOROS && NETWORKING
	depends on NETWORKING
	depends on NET_SOCKETS
	depends on DNS_RESOLVER
	select SNTP
	select NET_SOCKETS_SERVICE
	help
	  Synchronize SYS_CLOCK_REALTIME from an SNTP server. Publishers that
	  need ROS timestamps can publish immediately with a zero stamp and
	  switch to realtime stamps after the first successful sync.

if APP_TIME_SYNC

config APP_TIME_SNTP_SERVER
	string "SNTP server"
	default "pool.ntp.org"

config APP_TIME_SNTP_TIMEOUT_MS
	int "SNTP query timeout in milliseconds"
	default 3000

config APP_TIME_SNTP_RETRY_SEC
	int "SNTP retry interval after failure, in seconds"
	default 15
	range 1 3600

config APP_TIME_SNTP_RESYNC_SEC
	int "SNTP resync interval after success, in seconds"
	default 3600
	range 60 86400

endif # APP_TIME_SYNC

menuconfig APP_MOTORS
	bool "Enable differential drive motor control"
	default y
	depends on ACTUATOR
	help
	  Drives the two h-bridge wheel motors from cmd_vel twist commands
	  with open-loop duty mixing and a stop-on-silence watchdog.

if APP_MOTORS

config APP_MOTORS_WHEEL_SEPARATION_MM
	int "Wheel separation (track width) in mm"
	default 125
	help
	  Distance between the left and right wheel contact points.
	  Vendor value for the Waveshare RaspRover is 125 mm.

config APP_MOTORS_MAX_SPEED_MM_S
	int "Wheel speed mapped to 100% duty, in mm/s"
	default 500
	help
	  Open-loop scaling: a commanded wheel speed of this magnitude
	  produces full PWM duty. Tune on hardware.

config APP_MOTORS_CMD_TIMEOUT_MS
	int "Stop motors after this many ms without a cmd_vel"
	default 500

endif # APP_MOTORS

menuconfig APP_GIMBAL
	bool "Enable gimbal bus-servo control"
	default y
	depends on ACTUATOR
	help
	  Controls the Waveshare pan/tilt gimbal through two actuator devices.

if APP_GIMBAL

config APP_PICOROS_GIMBAL_CMD_TOPIC
	string "ROS topic for gimbal JointState commands"
	default "rasprover/gimbal_cmd"
	depends on APP_PICOROS
	help
	  sensor_msgs/JointState position setpoints for the pan/tilt head. A
	  command must name both pan_joint and tilt_joint; partial commands are
	  rejected.

endif # APP_GIMBAL

rsource "../common/picoros/Kconfig"
rsource "../common/watchdog/Kconfig"

source "Kconfig.zephyr"
