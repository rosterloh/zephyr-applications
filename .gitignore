# editors
# .vscode
*.swp
*~

# python
.venv
__pycache__/
.cache/
.ruff_cache/

# west dependencies (managed via deps/ by west update)
/deps/

# west internals (keep .west/config committed)
/.west/cache
/.west/tmp

# build artifacts
/builds/
/compile_commands.json
/logs/
**/build
/twister-out*

# environment
.env

# Claude Code. The skills themselves live in /.agents/skills/, which Codex
# discovers natively; /.claude/skills is a symlink to them so Claude Code sees
# the same tree. The symlink still has to be tracked, or a fresh clone has no
# skills for Claude.
#
# The global ~/.gitignore ignores /.claude/ wholesale, so un-ignore the
# directory here and re-include only the shared part. Order matters, and so
# does un-ignoring .claude/ itself first: git never descends into an excluded
# directory, so contents of one cannot be re-included.
#
# No trailing slash on the last rule: it matches a symlink, not a directory,
# and `!/.claude/skills/` would silently fail to re-include it.
!/.claude/
/.claude/*
!/.claude/skills

# misc
*.pdf

.embedder
