# editors
# .vscode
*.swp
*~

# python
.venv
__pycache__/
.cache/
.ruff_cache/

# west dependencies (managed via deps/ by west update)
/deps/

# west internals (keep .west/config committed)
/.west/cache
/.west/tmp

# build artifacts
/builds/
/compile_commands.json
/logs/
**/build
/twister-out*

# environment
.env

# Claude Code. The global ~/.gitignore ignores /.claude/ wholesale, but this
# project tracks shared skills and commands, so un-ignore the directory here
# and re-include only the shared parts. Order matters, and so does un-ignoring
# .claude/ itself first: git never descends into an excluded directory, so
# contents of one cannot be re-included. Without this, `git add` needs -f and,
# worse, brand-new skill files are silently skipped by `git add .`.
!/.claude/
/.claude/*
!/.claude/commands/
!/.claude/skills/

# misc
*.pdf

.embedder
