/dts-v1/;
#include <atmel/samd21.dtsi>
#include <atmel/samx2xx18.dtsi>
#include "robotis_openrb_150-pinctrl.dtsi"
#include "arduino_mkr_connector.dtsi"

/ {
	compatible = "robotis,openrb-150", "atmel,samd21g18a", "atmel,samd21";
	model = "Robotis OpenRB-150";

	chosen {
		zephyr,console = &sercom5;
		zephyr,shell-uart = &sercom5;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&portb 8 0>;
			label = "User LED";
		};
	};

	/* Not enabled: a pwm-leds node on &tcc3 channel 6, PWM_MSEC(20) (see &tcc3 below). */

	dxl_pwr: dxl-pwr {
		compatible = "regulator-fixed";
		regulator-name = "dxl-pwr-sw";
		enable-gpios = <&porta 28 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		status = "okay";
	};

	aliases {
		led0 = &led0;
	};
};

&cpu0 {
	clock-frequency = <48000000>;
};

&sercom0 {
	compatible = "atmel,sam0-i2c";
	clock-frequency = <I2C_BITRATE_FAST>;
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-0 = <&sercom0_i2c_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sercom1 {
	compatible = "atmel,sam0-spi";
	dipo = <3>;
	dopo = <0>;
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-0 = <&sercom1_spi_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sercom2 {
	compatible = "atmel,sam0-uart";
	current-speed = <115200>;
	rxpo = <1>;
	txpo = <0>;

	pinctrl-0 = <&sercom2_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sercom4 {
	compatible = "atmel,sam0-uart";
	current-speed = <115200>;
	rxpo = <3>;
	txpo = <2>;

	pinctrl-0 = <&sercom4_uart_default>;
	pinctrl-names = "default";
	status = "disabled";
};

&sercom5 {
	compatible = "atmel,sam0-uart";
	current-speed = <115200>;
	rxpo = <3>;
	txpo = <2>;

	pinctrl-0 = <&sercom5_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* Not enabled: &tcc3 as atmel,sam0-tcc-pwm with prescaler = <1024> (max period
 * 1.4 s), #pwm-cells = <2> and pinctrl &pwm_default.
 */

&dac0 {

	pinctrl-0 = <&dac_default>;
	pinctrl-names = "default";
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			reg = <0x00000000 DT_SIZE_K(8)>;
			label = "sam-ba"; // "bootloader" "uf2" "sam-ba"
			read-only;
		};

		code_partition: partition@2000 {
			reg = <0x2000 DT_SIZE_K(256-8-16)>;
			label = "code";
			read-only;
		};

		/*
		 * The final 16 KiB is reserved for the application.
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@3c000 {
			reg = <0x0003c000 DT_SIZE_K(16)>;
			label = "storage";
		};
	};
};

zephyr_udc0: &usb0 {

	pinctrl-0 = <&usb_dc_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* Zephyr-shield convention: shields hook &zephyr_i2c. Alias the Arduino
 * MKR I2C bus so out-of-tree shields apply on OpenRB.
 */
zephyr_i2c: &arduino_mkr_i2c {};
