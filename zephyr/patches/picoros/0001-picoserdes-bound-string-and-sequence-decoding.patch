From: Richard Osterloh <richard.osterloh@gmail.com>
Subject: [PATCH] picoserdes: bound string and string-sequence decoding

ucdr_deserialize_rstring() advanced the iterator by the length read off the
wire without checking it against the buffer, and returned a pointer to a
string whose terminating NUL it never checked. A peer that declares a string
longer than the payload -- or a length near UINT32_MAX, which wraps the
iterator backwards on a 32-bit target -- makes every later read, and any
strcmp()/strlen() on the returned pointer, run outside the received buffer.

Refuse a length of zero, one past what is left of the buffer, or one whose
last byte is not NUL: set ub->error and return false without advancing past
the string. ucdr_deserialize_sequence_rstring() now reports a failed count
read, sets ub->error when the count exceeds the capacity, and leaves *number
at 0 on any failure instead of the untrusted count. Well-formed input decodes
exactly as before.
---
--- a/src/picoserdes.c
+++ b/src/picoserdes.c
@@ -72,14 +72,22 @@
 // Deserialize string without copy
 bool ucdr_deserialize_rstring(ucdrBuffer* ub, char** pstring){
     uint32_t len = 0;
-    bool ret = ucdr_deserialize_endian_uint32_t(ub, ub->endianness, &len);
-    if (ret){
-        *pstring = (char*)ub->iterator;
-        ub->iterator += len;
-        ub->offset += len;
-        ub->last_data_size = 1;
+    if (!ucdr_deserialize_endian_uint32_t(ub, ub->endianness, &len)){
+        return false;
     }
-    return ret;
+    // The length comes off the wire. It must fit what is left of the buffer
+    // and include the terminating NUL; otherwise the returned pointer runs
+    // past the end, and a length near UINT32_MAX wraps the iterator backwards
+    // on a 32-bit target. Refuse without moving the iterator.
+    if (len == 0 || len > ucdr_buffer_remaining(ub) || ub->iterator[len - 1] != '\0'){
+        ub->error = true;
+        return false;
+    }
+    *pstring = (char*)ub->iterator;
+    ub->iterator += len;
+    ub->offset += len;
+    ub->last_data_size = 1;
+    return true;
 }

 // Wrapper for having consistent names
@@ -109,16 +117,22 @@

 // Deserialize strings sequence to array of string pointers
 bool ucdr_deserialize_sequence_rstring(ucdrBuffer* ub, char** strings, uint32_t max_number, uint32_t* number){
-    ucdr_deserialize_endian_uint32_t(ub, ub->endianness, number);
-    if (*number <= max_number){
-        for (int i = 0; i < *number; i++){
-            if (ucdr_deserialize_rstring(ub, &strings[i]) == false){
-                return false;
-            }
+    uint32_t count = 0;
+    *number = 0;
+    if (!ucdr_deserialize_endian_uint32_t(ub, ub->endianness, &count)){
+        return false;
+    }
+    if (count > max_number){
+        ub->error = true;
+        return false;
+    }
+    for (uint32_t i = 0; i < count; i++){
+        if (ucdr_deserialize_rstring(ub, &strings[i]) == false){
+            return false;
         }
-        return true;
     }
-    return false;
+    *number = count;
+    return true;
 }

 // Serialize array of string pointers
