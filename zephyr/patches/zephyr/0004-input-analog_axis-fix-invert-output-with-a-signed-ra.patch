From 0d71cc65caf1889023aa56e5d99c1c9dd328a1db Mon Sep 17 00:00:00 2001
From: Richard Osterloh <richard.osterloh@gmail.com>
Date: Mon, 2 Nov 2026 17:01:14 +0000
Subject: [PATCH] input: analog_axis: fix invert-output with a signed range

invert-output computed out-max - out, which only mirrors the value when
out-min is 0. With a signed range such as -1000..1000 a centred axis
read 1000 instead of 0 and full deflection 2000, outside the declared
range. Mirror within the range instead: out-max + out-min - out.

Signed-off-by: Richard Osterloh <richard.osterloh@gmail.com>
Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/input_analog_axis.c   | 2 +-
 dts/bindings/input/analog-axis.yaml | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/input/input_analog_axis.c b/drivers/input/input_analog_axis.c
index dcfd873701b..4a1378391a8 100644
--- a/drivers/input/input_analog_axis.c
+++ b/drivers/input/input_analog_axis.c
@@ -213,7 +213,7 @@ static void analog_axis_loop(const struct device *dev)
 		out = clamp(out, axis_cfg->out_min, axis_cfg->out_max);
 
 		if (axis_cfg->invert_output) {
-			out = axis_cfg->out_max - out;
+			out = axis_cfg->out_max + axis_cfg->out_min - out;
 		}
 
 		if (axis_data->last_out != out) {
diff --git a/dts/bindings/input/analog-axis.yaml b/dts/bindings/input/analog-axis.yaml
index 55805529950..cab8b1776f7 100644
--- a/dts/bindings/input/analog-axis.yaml
+++ b/dts/bindings/input/analog-axis.yaml
@@ -79,7 +79,8 @@ child-binding:
     invert-output:
       type: boolean
       description: |
-        If set, invert the output value.
+        If set, invert the output value, mirroring it within out-min and
+        out-max.
 
 examples:
   - |
