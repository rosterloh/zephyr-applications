From 40949ae320ed268d9fdb26064288261b175c86bb Mon Sep 17 00:00:00 2001
From: Richard Osterloh <richard.osterloh@gmail.com>
Date: Sun, 8 Nov 2026 21:00:00 +0000
Subject: [PATCH] drivers: video: esp32_dvp: capture JPEG frames

The LCD_CAM already ends a DMA transfer at VSYNC, but the driver
programmed pitch * height bytes per buffer, which is 0 for JPEG.

For JPEG, give the DMA the whole buffer and take the received length
from the DMA status at end of frame. Drop frames that do not start with
SOI (capture began mid-frame) or that fill the buffer without reaching
VSYNC, and trim the length at EOI on dequeue, since the DMA count can
include a prefetched descriptor.

Assisted-by: Claude:claude-opus-5.5
---
 drivers/video/video_esp32_dvp.c | 63 +++++++++++++++++++++++++++++++--
 1 file changed, 61 insertions(+), 2 deletions(-)

diff --git a/drivers/video/video_esp32_dvp.c b/drivers/video/video_esp32_dvp.c
index 6f46aa4d0..04287d064 100644
--- a/drivers/video/video_esp32_dvp.c
+++ b/drivers/video/video_esp32_dvp.c
@@ -97,13 +97,40 @@ static int video_esp32_reload_dma(struct video_esp32_data *data)
 	return 0;
 }
 
+static bool video_esp32_is_jpeg(const struct video_esp32_data *data)
+{
+	return data->video_format.pixelformat == VIDEO_PIX_FMT_JPEG;
+}
+
+/*
+ * A JPEG frame ends at VSYNC, so its length is what the DMA wrote. The count
+ * can include the next, prefetched descriptor; dequeue trims it at EOI.
+ */
+static size_t video_esp32_jpeg_received(struct video_esp32_data *data)
+{
+	const struct video_esp32_config *cfg = data->config;
+	struct dma_status stat;
+
+	if (dma_get_status(cfg->dma_dev, cfg->rx_dma_channel, &stat) < 0) {
+		return 0;
+	}
+
+	return MIN(stat.total_copied, data->active_vbuf->bytesused);
+}
+
 void video_esp32_dma_rx_done(const struct device *dev, void *user_data, uint32_t channel,
 			     int status)
 {
 	struct video_esp32_data *data = user_data;
+	size_t len;
 
 	if (status == DMA_STATUS_BLOCK) {
-		LOG_DBG("received block");
+		/* A JPEG frame larger than the buffer never reaches EOF: drop it. */
+		if (video_esp32_is_jpeg(data) && data->active_vbuf != NULL &&
+		    video_esp32_jpeg_received(data) >= data->active_vbuf->bytesused) {
+			LOG_WRN("JPEG frame larger than %u B, dropped", data->active_vbuf->size);
+			video_esp32_reload_dma(data);
+		}
 		return;
 	}
 
@@ -119,6 +146,17 @@ void video_esp32_dma_rx_done(const struct device *dev, void *user_data, uint32_t
 		return;
 	}
 
+	if (video_esp32_is_jpeg(data)) {
+		len = video_esp32_jpeg_received(data);
+		/* No SOI: capture started mid-frame, after a drop or stream start */
+		if (len < 2 || data->active_vbuf->buffer[0] != 0xFF ||
+		    data->active_vbuf->buffer[1] != 0xD8) {
+			video_esp32_reload_dma(data);
+			return;
+		}
+		data->active_vbuf->bytesused = len;
+	}
+
 	data->active_vbuf->timestamp = k_uptime_get_32();
 	k_fifo_put(&data->fifo_out, data->active_vbuf);
 	VIDEO_ESP32_RAISE_OUT_SIG_IF_ENABLED(VIDEO_BUF_DONE)
@@ -299,7 +337,12 @@ static int video_esp32_enqueue(const struct device *dev, struct video_buffer *vb
 {
 	struct video_esp32_data *data = dev->data;
 
-	vbuf->bytesused = data->video_format.pitch * data->video_format.height;
+	if (video_esp32_is_jpeg(data)) {
+		/* Variable length: the DMA may fill the whole buffer */
+		vbuf->bytesused = vbuf->size;
+	} else {
+		vbuf->bytesused = data->video_format.pitch * data->video_format.height;
+	}
 	vbuf->line_offset = 0;
 
 	k_fifo_put(&data->fifo_in, vbuf);
@@ -318,6 +361,22 @@ static int video_esp32_dequeue(const struct device *dev, struct video_buffer **v
 		return -EAGAIN;
 	}
 
+	if (video_esp32_is_jpeg(data)) {
+		/* EOI is in the last descriptors; 0xFF in entropy data is stuffed as FF 00. */
+		uint8_t *buf = (*vbuf)->buffer;
+		size_t len = (*vbuf)->bytesused;
+		size_t i = len > 3 * VIDEO_ESP32_DMA_BUFFER_MAX_SIZE
+				   ? len - 3 * VIDEO_ESP32_DMA_BUFFER_MAX_SIZE
+				   : 0;
+
+		for (; i + 1 < len; i++) {
+			if (buf[i] == 0xFF && buf[i + 1] == 0xD9) {
+				(*vbuf)->bytesused = i + 2;
+				break;
+			}
+		}
+	}
+
 	return 0;
 }
 
